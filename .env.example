# ==============================================================================
# Environnement & Base de données PostgreSQL
# ==============================================================================
POSTGRES_USER=pfe_user
POSTGRES_PASSWORD=pfe_secure_password_example
POSTGRES_DB=pfe_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pfe_user:pfe_secure_password_example@db:5432/pfe_db

# ==============================================================================
# Sécurité & Authentification JWT
# ==============================================================================
# Générer une clé secrète robuste (ex: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_super_secret_key_at_least_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# Paramètres Application FastAPI
# ==============================================================================
PROJECT_NAME="Plateforme de Gestion des Projets PFE"
ENVIRONMENT=development
DEBUG=True
APP_PORT=8000

# ==============================================================================
# Monitoring & Observabilité (Semaines 4 & 5)
# ==============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secure_password_example
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
